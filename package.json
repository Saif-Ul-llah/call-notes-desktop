{
  "name": "call-notes-desktop",
  "productName": "Call Notes",
  "version": "0.3.0",
  "description": "Offline real-time call and meeting transcription (English + Roman Urdu/Hindi)",
  "main": "out/main/index.js",
  "author": "Call Notes",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:linux": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "golden": "cross-env GOLDEN=1 vitest run src/engine/golden.test.ts",
    "fetch-models": "node scripts/fetch-models.mjs",
    "build-native": "node scripts/build-whisper-native.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build-native && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fugood/whisper.node": "1.2.0-rc.1"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cmake-js": "^7.4.0",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "node-addon-api": "^8.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
